/* KtAlarmClock lock screen (QWidget prototype) */

KtLockScreenPrimaryWidget, KtLockScreenSecondaryWidget {
    background-color: #000000;
    color: #2878bb;
}

QLabel#lockMsg {
    color: #2878bb;
    font-size: 20px;
}

QLabel#lockFormula {
    color: #2878bb;
    font-size: 20px;
}

QLineEdit#lockAnswer {
    background-color: #112a3f;
    border: 1px solid #2878bb;
    color: #2878bb;
    font-size: 24px;
    min-width: 80px;
    max-width: 120px;
    padding: 4px;
}

QPushButton#lockUnlockBtn {
    background-color: #242628;
    border: 1px solid #2878bb;
    color: #b9d9f0;
    font-size: 18px;
    padding: 8px 16px;
}

QPushButton#lockUnlockBtn:hover {
    background-color: #333333;
}

QPushButton#lockDebugBtn {
    background-color: #3d2020;
    border: 1px solid #c06060;
    color: #f0c0c0;
    font-size: 14px;
    padding: 6px 12px;
}

QPushButton#lockDebugBtn:hover {
    background-color: #5a3030;
}

QLabel#lockBreakTime {
    color: #46aef6;
    font-size: 14px;
    font-family: "Segoe UI";
}

QLabel#lockForceTime {
    color: #2878bb;
    font-size: 20px;
}

QLabel#lockSecondaryMsg {
    color: #2878bb;
    font-size: 16px;
}

QLabel#lockCoffee {
    font-size: 64px;
}
